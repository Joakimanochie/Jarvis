{
  "rewrites": [
    {
      "source": "/api/notion/:path*",
      "destination": "https://api.notion.com/v1/:path*"
    },
    {
      "source": "/api/nim/:path*",
      "destination": "https://integrate.api.nvidia.com/v1/:path*"
    },
    {
      "source": "/api/news/:path*",
      "destination": "https://newsapi.org/:path*"
    },
    {
      "source": "/api/search/:path*",
      "destination": "https://api.tavily.com/:path*"
    }
  ]
}
